{
  "name": "voice-studio-standalone",
  "version": "1.0.0",
  "private": true,
  "description": "Standalone personal voice control studio with reliable camera and screen-share previews.",
  "main": "server.js",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test",
    "check": "node --check server.js && node --check public/app.js && node --check scripts/scale-smoke.js",
    "test:scale": "node --expose-gc scripts/scale-smoke.js"
  },
  "dependencies": {
    "@dank074/discord-video-stream": "^7.0.0",
    "@lng2004/discord.js-selfbot-v13": "^3.7.2",
    "@lng2004/node-datachannel": "0.33.2-20260825",
    "express": "^5.2.1",
    "ffmpeg-static": "^5.3.0",
    "helmet": "^8.1.0"
  },
  "overrides": {
    "sharp": "^0.35.4"
  },
  "license": "MIT"
}
