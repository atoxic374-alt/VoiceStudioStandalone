# Required in production
NODE_ENV=production
APP_PASSWORD=replace-with-a-long-random-owner-password
CLIENT_PASSWORD=replace-with-a-different-long-client-password
DATA_ENCRYPTION_KEY=replace-with-a-long-random-storage-key

# Railway supplies PORT automatically; do not hard-code it.
# Discord tokens are entered through the authenticated HTTPS UI and stored encrypted in data/accounts.enc.

# Optional Playing Discord commands. Send `start` or `stop` in the configured
# channel to control all saved Playing sessions. DISCORD_COMMAND_OWNERS is
# required: only these Discord user IDs can execute the commands.
# DISCORD_COMMAND_CHANNEL_ID=your-text-channel-id
DISCORD_COMMAND_OWNERS=636930315503534110,717064763489779786,1222221195672289451
# DISCORD_COMMAND_PREFIX=
