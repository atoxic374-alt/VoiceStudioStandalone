# Required in production
NODE_ENV=production
APP_PASSWORD=replace-with-a-long-random-owner-password
CLIENT_PASSWORD=replace-with-a-different-long-client-password
DATA_ENCRYPTION_KEY=replace-with-a-long-random-storage-key

# Railway supplies PORT automatically; do not hard-code it.
# Discord tokens are entered through the authenticated HTTPS UI and stored encrypted in data/accounts.enc.

# Optional Playing Discord commands. Send `start` or `stop` in the configured
# channel to control all saved Playing sessions. DISCORD_COMMAND_OWNERS is
# required: only these Discord user IDs can execute the commands.
# DISCORD_COMMAND_CHANNEL_ID=your-text-channel-id
DISCORD_COMMAND_OWNERS=636930315503534110,717064763489779786,1222221195672289451
# DISCORD_COMMAND_PREFIX=
# Shared minimum gap between Playing REST operations across all accounts.
# Increase this when running many accounts/tasks together.
# DISCORD_REQUEST_GAP_MS=120
# Optional gap after each media attempt. Default is zero: the next account
# starts immediately after the previous attempt returns ready or failed.
# MEDIA_START_GAP_MS=0
# Watchdog checks active rotations, state cycles, Playing sessions, and voice
# drift. It repairs only after two consecutive misses and uses a cooldown.
# VOICE_WATCHDOG_INTERVAL_MS=10000
# VOICE_WATCHDOG_COOLDOWN_MS=30000
# Maximum accounts moved or state-updated concurrently by automation tasks.
# Lower this to 1 for the most conservative behavior.
# VOICE_AUTOMATION_CONCURRENCY=2
# Dedicated media voice join timeout (the library waits for Gateway voice events).
# MEDIA_JOIN_TIMEOUT_MS=20000
# WebRTC readiness timeout after the dedicated connection is created.
# MEDIA_WEBRTC_TIMEOUT_MS=10000
